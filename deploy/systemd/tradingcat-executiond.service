[Unit]
Description=TradingCat v5 isolated execution approval daemon (P0-A dry-run only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradingcat-exec
Group=tradingcat-exec
WorkingDirectory=${TS_ROOT}
Environment=PYTHONPATH=${TS_ROOT}
Environment=TRADING_CORE_DB=/var/lib/tradingcat/core/core.db
Environment=TRADING_EXECUTION_DB=/var/lib/tradingcat/execution/execution.db
Environment=TRADINGCAT_REQUIRE_SEPARATE_CREDENTIALS=1
EnvironmentFile=/etc/tradingcat/executiond.env
ExecStart=/usr/bin/python3 -m execution.daemon --socket /run/tradingcat/executiond.sock
RuntimeDirectory=tradingcat
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/tradingcat/core
ReadWritePaths=/var/lib/tradingcat/execution /run/tradingcat
UMask=0077
Restart=on-failure

[Install]
WantedBy=multi-user.target
