# TradingCat 交易系统 — 环境变量模板
# =====================================================================
# 用法：
#   1. 本地开发：cp .env.example .env 后填入真实值
#      （shared/longbridge_client.py 会读取项目 .env 或已导出的环境变量）
#   2. systemd / cron / docker：直接 export 同名变量（见 docs/deploy.md）
# 安全：.env 含密钥，严禁提交到 git（若仓库未忽略，请加入 .gitignore）。
#
# 变量名以实际代码为准：
#   - shared/longbridge_client.py → LONGBRIDGE_APP_KEY / LONGBRIDGE_APP_SECRET
#     / LONGBRIDGE_ACCESS_TOKEN / LONGBRIDGE_HTTP_URL（可选）
#   - production/subscribe.py      → TRADINGCAT_WEBHOOK_URL
#   - config.yaml 中直接引用 ${LONGBRIDGE_APP_KEY} / ${LONGBRIDGE_APP_SECRET}
#     / ${LONGBRIDGE_ACCESS_TOKEN}，与上方变量名完全一致；
#     文档中的 App Key / App Secret 指这里的 LONGBRIDGE_* 变量。
# =====================================================================

# ── 长桥 OpenAPI（唯一行情/券商源；必需）────────────────────────
# 长桥开放平台 App Key（开放平台 → 应用凭证）
LONGBRIDGE_APP_KEY=your_app_key
# 长桥开放平台 App Secret
LONGBRIDGE_APP_SECRET=your_app_secret
# 长桥开放平台应用凭证中的 Legacy API Key Access Token
# 注意：不是 `longbridge auth login` 生成的 OAuth token。
LONGBRIDGE_ACCESS_TOKEN=your_access_token
# 兼容版 SDK 通常无需覆盖端点；只有长桥明确要求时才设置其官方 URL 变量：
# LONGBRIDGE_HTTP_URL=https://openapi.longbridgeapp.com
# LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridgeapp.com/v2
# LONGBRIDGE_TRADE_WS_URL=wss://openapi-trade.longbridgeapp.com/v2
# 可选：指定其他 env 文件；未设置时读取项目根目录 .env
# TRADINGCAT_ENV_FILE=/absolute/path/to/tradingcat.env

# 可选的最小权限隔离：研究/行情进程只读 QUOTE_*，执行服务只读 TRADE_*。
# 配齐后可设为 1，禁止回退到上方兼容三凭证。
# LONGBRIDGE_QUOTE_APP_KEY=your_quote_app_key
# LONGBRIDGE_QUOTE_APP_SECRET=your_quote_app_secret
# LONGBRIDGE_QUOTE_ACCESS_TOKEN=your_quote_access_token
# LONGBRIDGE_TRADE_APP_KEY=your_trade_app_key
# LONGBRIDGE_TRADE_APP_SECRET=your_trade_app_secret
# LONGBRIDGE_TRADE_ACCESS_TOKEN=your_trade_access_token
# TRADINGCAT_REQUIRE_SEPARATE_CREDENTIALS=1

# ── 推送（可选）─────────────────────────────────────────────────────
# 订阅报告 webhook URL；未配置则只落盘 reports/YYYY-MM-DD/，不推送
TRADINGCAT_WEBHOOK_URL=
# 监控/执行事件通用 JSON Webhook；未配置时通知只写 audit_log。
TRADINGCAT_NOTIFICATION_WEBHOOK=

# 远程审批身份验证（微信 OpenID/网关 subject → 系统 owner）。
# 密钥至少 32 字符；OWNER_MAP 是 JSON，例 {"wx-openid-xxx":"owner"}。
TRADINGCAT_APPROVAL_IDENTITY_SECRET=
TRADINGCAT_APPROVAL_OWNER_MAP=

# ── 数据（可选）─────────────────────────────────────────────────────
# Core store；TRADING_DB 是向后兼容别名。
TRADING_CORE_DB=
# executiond 私有 store；生产必须与 Core 不同路径且由独立 OS 用户持有。
TRADING_EXECUTION_DB=
# TRADING_DB=
# 安装到只读 site-packages 时指定独立可写运行目录及产物目录。
TRADINGCAT_RUNTIME_DIR=
TRADINGCAT_REPORTS_DIR=
TRADINGCAT_BACKUP_DIR=

# ── 当前基本面补充（可选，不得用于历史回测）────────────────────────
# OpenAlice/TraderHub 桥接命令。命令从 stdin 读取 tradingcat.provider.v1 JSON，
# stdout 返回 JSON object；系统直接传 argv、不经 shell。未配置时基本面安全缺失。
# TRADINGCAT_OPENALICE_ADAPTER_COMMAND=/usr/local/bin/openalice-tradingcat-adapter
